generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  PRO
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?
  googleId      String?   @unique
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paddleCustomerId String? @unique

  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  usage         Usage[]
  settings      UserSettings?
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/* one row per Paddle subscription, kept in sync by the webhook */
model Subscription {
  id                   String    @id // Paddle subscription id (sub_...)
  userId               String
  status               String // active | trialing | past_due | paused | canceled
  priceId              String?
  interval             String? // month | year
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  lastEventAt          DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Usage {
  userId     String
  day        DateTime @db.Date
  aiMessages Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model UserSettings {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
