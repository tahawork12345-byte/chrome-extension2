# Copy to .env and fill in. On Vercel, set the same keys in Project Settings -> Environment Variables.

# --- Server ---
PORT=3001
# public URL of this backend (used for the Paddle checkout page)
APP_URL=http://localhost:3001
# comma-separated chrome extension IDs allowed to call the API (empty = any extension, dev only)
ALLOWED_EXTENSION_IDS=

# --- Database (Supabase -> Project Settings -> Database -> Connection string) ---
# pooled connection (port 6543), used at runtime
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# direct connection (port 5432), used by prisma migrate
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth ---
# long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# OAuth client IDs whose Google tokens we accept (comma-separated).
# Create a "Chrome Extension" client in Google Cloud Console -> Credentials.
GOOGLE_CLIENT_IDS=

# --- AI (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
# every Pro feature free for everyone (for now); false brings the Pro plan back
ALL_FREE=true
AI_DAILY_LIMIT_FREE=20
AI_DAILY_LIMIT_PRO=500

# --- Paddle Billing (https://vendors.paddle.com or sandbox-vendors.paddle.com) ---
PADDLE_ENV=sandbox
PADDLE_API_KEY=
# Developer tools -> Notifications -> your webhook destination -> secret key
PADDLE_WEBHOOK_SECRET=
# Developer tools -> Authentication -> client-side token (used by public/checkout.html)
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_MONTHLY=pri_xxx
PADDLE_PRICE_YEARLY=pri_xxx

# --- Weekly stats email (Pro) ---
# https://resend.com -> API Keys. EMAIL_FROM must be on a domain verified there.
RESEND_API_KEY=
EMAIL_FROM="Atlas <hello@yourdomain.com>"
# long random string; Vercel Cron sends it to /cron/weekly-email (Mondays 08:00 UTC)
CRON_SECRET=

# --- Premium wallpapers (Pro) ---
# the CDN folder holding the files listed in src/data/wallpapers.js, no trailing slash
# (e.g. a public Cloudflare R2 / Bunny / S3 bucket URL)
WALLPAPER_CDN=https://pub-abc123.r2.dev
